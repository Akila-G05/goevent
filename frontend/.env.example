# GoEvent Frontend Environment Variables Template
# Copy this file to .env.local:
#   cp .env.example .env.local

# Routes include /goevent/api. Leave API_URL empty for the same-origin Next proxy,
# or set an API origin such as https://api.example.com (without a path).
API_URL=
BACKEND_URL=http://localhost:8080

# Google OAuth 2.0 Web Client ID from Google Cloud Console
# Example: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
