# Ephemeral cache, rate limits and sessions: restart invalidates all three.
protected-mode yes
bind 0.0.0.0
port 0
tls-port 6379
tls-cert-file /run/secrets/redis.crt
tls-key-file /run/secrets/redis.key
tls-ca-cert-file /run/secrets/redis-ca.crt
tls-auth-clients no
aclfile /run/secrets/redis.acl
maxmemory 256mb
maxmemory-policy noeviction
save ""
appendonly no
dir /data
notify-keyspace-events Egx
