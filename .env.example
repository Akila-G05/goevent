# ==============================================================================
# GoEvent Environment Configuration Template
# Copy this file to .env for local development overrides:
#   cp .env.example .env
# Never commit real secrets, tokens, or private keys to source control.
# ==============================================================================

# Use plain KEY=value syntax shared by Compose and Spring properties imports.
# For passwords, use long random letters/digits (e.g. openssl rand -hex 24).
# Avoid quotes, backslashes, dollar interpolation, and inline comments in values.
# Database Configuration (MySQL 8.4 LTS; backend runs on the host)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=goevent
DB_USER=goevent
DB_PASSWORD=replace_with_random_app_password
DB_ROOT_PASSWORD=replace_with_different_random_root_password

# Backend Application Configuration
PORT=8081
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=your-256-bit-secret-must-be-at-least-32-characters-long!
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend Configuration (Next.js; NEXT_PUBLIC_* values are public)
# Next.js reads frontend/.env.local, not the repository root .env.
# These retain the existing frontend rewrite defaults; API prefix alignment is separate.
NEXT_PUBLIC_API_BASE_URL=/api/v1
BACKEND_URL=http://localhost:8080
