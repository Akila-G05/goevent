# ==============================================================================
# GoEvent Environment Configuration Template
# Copy this file to .env for local development overrides:
#   cp .env.example .env
# Never commit real secrets, tokens, or private keys to source control.
# ==============================================================================

# Database Configuration (MySQL 8.4 LTS)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=goevent
DB_USER=goevent
DB_PASSWORD=goevent_local_password
DB_ROOT_PASSWORD=root_local_password

# Backend Application Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=your-256-bit-secret-must-be-at-least-32-characters-long!
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend Configuration (Vite)
# Vite variables exposed to browser MUST begin with VITE_
VITE_API_BASE_URL=http://localhost:8080/api/v1
